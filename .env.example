# ClauseTrace local config. Copy to .env and fill secrets.
# Never commit .env.
#
# Hybrid database: SQLite is the default (zero setup). Set
# CLAUSETRACE_DB_URL to use Postgres instead (e.g. the Docker stack:
# PGPASSWORD=<pw> docker compose up --build -d, Postgres on 127.0.0.1:5543).
# `make reset-demo` and `make seed` follow the same variable.

# Meta Model API (https://api.meta.ai/v1). Required only when LLM_MODE=live.
MODEL_API_KEY=

# live | replay | mock. Default replay. Tests must never use live.
LLM_MODE=replay

# 1 = serve openapi/examples fixtures instead of the real router. Default 1.
API_STUB=1

# 1 = allow POST /api/demo/reset and /api/demo/scenario/{name}.
# Default 0 (off; turn on only when a demo needs it). The Docker image sets 1.
DEMO_MODE=0

# --- Database (pick one; URL wins when set) ---
# Optional SQLite path. Default: backend/db.sqlite3 (gitignored).
# CLAUSETRACE_DB=
# Postgres URL. Example for the compose stack (host port 5543):
# CLAUSETRACE_DB_URL=postgresql+psycopg://clausetrace:<pw>@127.0.0.1:5543/clausetrace
# Example for an external server (e.g. existing aegis-postgres on :5432):
# CLAUSETRACE_DB_URL=postgresql+psycopg://aegis:aegis_secret@127.0.0.1:5432/aegis_sandbox

# --- Graph projection (FalkorDB, optional) ---
# The API tries FalkorDB first for dependency traversal and falls back to
# the record database when unreachable. No password = unauthenticated host.
# CT_GRAPH_HOST=127.0.0.1
# CT_GRAPH_PORT=6379
# CT_GRAPH_NAME=clausetrace
# CT_GRAPH_PASSWORD=

# --- Identity (optional) ---
# 1 = require bearer tokens on /api/* (except health/docs/openapi).
# CT_AUTH_REQUIRED=0
# Token signing secret. MUST be set outside local dev.
# CT_AUTH_SECRET=

# --- Budgets (optional) ---
# Per-tenant USD cap for model calls; unset = no limit.
# CT_TENANT_BUDGET_USD=

# --- Challenger (second Muse Spark pass) ---
CHALLENGER=off
CHALLENGER_PROVIDER=meta

# --- Frontend (Vite). Copy these into frontend/.env.local if you use the stub server.
# VITE_API_BASE=http://localhost:8000
# VITE_USE_LIVE_API=0

# --- Cross-origin frontend (Vercel + own server) ---
# Comma-separated origins allowed to call the API in browsers (or "*" for
# open demos). Unset = no CORS headers (same-origin / proxy only).
# CT_CORS_ORIGINS=https://your-app.vercel.app

# --- Dev/test only (shell env, not .env) ---
# CT_GRAPH_TEST=1 with a reachable FalkorDB runs the projection parity test.
# CLAUSETRACE_PG_URL=... runs the Postgres migration parity test.
# PGPASSWORD=... password for `docker compose up` (defaults to clausetrace_pw).
